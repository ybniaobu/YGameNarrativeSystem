# YNarrative.Core is a .NET package, also distributed as a Unity UPM package, so this file
# combines .NET build rules and Unity rules.
#
# Get latest Unity rules from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# YNarrative.Core.csproj is tracked. Generated *.csproj files are ignored.

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Oo]ut/
artifacts/
*.nupkg
*.snupkg

# Test results and coverage
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.xml
coverage*.json
*.cobertura.xml

# NuGet restore
.nuget/
project.lock.json
project.fragment.lock.json

# Unity project cache, in case the package folder is opened as a Unity project
/.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
*.log

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# IDEs and editors
.idea/
.vscode/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
!YNarrative.Core.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb
*.tmp
*.DotSettings.user
*.sln.docstates
*.rsuser
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# UI Toolkit auto generated files
/UIElementsSchema/

# OS generated files
.DS_Store
Thumbs.db
